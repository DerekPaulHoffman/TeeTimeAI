{
  "manifest_version": 3,
  "name": "Tee Time Spot Local Reader",
  "version": "1.3.0",
  "description": "Reads allowlisted public tee-time pages for Tee Time Spot alerts.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://teetimespot.com/*",
    "http://127.0.0.1:4317/*",
    "https://grassyhill.cps.golf/*",
    "https://overpeckgc.cps.golf/*",
    "https://golfatglenmills.cps.golf/*",
    "https://yarmouthpublic.cps.golf/*",
    "https://traditionoaklane.cps.golf/*",
    "https://candiawoods.cps.golf/*",
    "https://oxfordgreens.cps.golf/*",
    "https://shennecossett.cps.golf/*",
    "https://stanleygolf.cps.golf/*",
    "https://colonie.cps.golf/*",
    "https://springfield.cps.golf/*",
    "https://pinehollow.cps.golf/*",
    "https://capitalhillsny.cps.golf/*",
    "https://www.chronogolf.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tee Time Spot Local Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grassyhill.cps.golf/onlineresweb/search-teetime*",
        "https://overpeckgc.cps.golf/onlineresweb/search-teetime*",
        "https://golfatglenmills.cps.golf/onlineresweb/search-teetime*",
        "https://yarmouthpublic.cps.golf/onlineresweb/search-teetime*",
        "https://traditionoaklane.cps.golf/onlineresweb/search-teetime*",
        "https://candiawoods.cps.golf/onlineresweb/search-teetime*",
        "https://oxfordgreens.cps.golf/onlineresweb/search-teetime*",
        "https://shennecossett.cps.golf/onlineresweb/search-teetime*",
        "https://stanleygolf.cps.golf/onlineresweb/search-teetime*",
        "https://colonie.cps.golf/onlineresweb/search-teetime*",
        "https://springfield.cps.golf/onlineresweb/search-teetime*",
        "https://pinehollow.cps.golf/onlineresweb/search-teetime*",
        "https://capitalhillsny.cps.golf/onlineresweb/search-teetime*"
      ],
      "js": ["cps-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chronogolf.com/club/crestbrook-park-golf-course*",
        "https://www.chronogolf.com/club/crystal-lake-golf-club-rhode-island-mapleville*",
        "https://www.chronogolf.com/club/chanticlair-golf-club*"
      ],
      "js": ["chronogolf-reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
