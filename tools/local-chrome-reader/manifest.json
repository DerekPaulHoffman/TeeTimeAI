{
  "manifest_version": 3,
  "name": "Tee Time Spot Local Reader",
  "version": "1.0.0",
  "description": "Reads allowlisted public tee-time pages for Tee Time Spot alerts.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://teetimespot.com/*",
    "http://127.0.0.1:4317/*",
    "https://grassyhill.cps.golf/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tee Time Spot Local Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grassyhill.cps.golf/onlineresweb/search-teetime*"
      ],
      "js": ["grassy-hill-reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
