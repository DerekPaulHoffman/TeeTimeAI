{
  "manifest_version": 3,
  "name": "Tee Time Spot Local Reader",
  "version": "1.4.2",
  "description": "Reads allowlisted public tee-time pages for Tee Time Spot alerts.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://teetimespot.com/*",
    "http://127.0.0.1:4317/*",
    "https://*.cps.golf/*",
    "https://www.chronogolf.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tee Time Spot Local Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.cps.golf/onlineresweb/search-teetime*"
      ],
      "js": ["cps-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chronogolf.com/club/crestbrook-park-golf-course*",
        "https://www.chronogolf.com/club/crystal-lake-golf-club-rhode-island-mapleville*",
        "https://www.chronogolf.com/club/chanticlair-golf-club*",
        "https://www.chronogolf.com/club/lyman-orchards-golf-club*",
        "https://www.chronogolf.com/club/hyde-park-golf-club*"
      ],
      "js": ["chronogolf-reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
