{
  "manifest_version": 3,
  "name": "Tee Time Spot Local Reader",
  "version": "1.10.1",
  "description": "Reads allowlisted public tee-time pages for Tee Time Spot alerts.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://teetimespot.com/*",
    "http://127.0.0.1:4317/*",
    "https://*.cps.golf/*",
    "https://www.chronogolf.com/*",
    "https://fox.tenfore.golf/*",
    "https://*.ezlinksgolf.com/*",
    "https://*.myvscloud.com/*",
    "https://secure.east.prophetservices.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tee Time Spot Local Reader"
  },
  "content_scripts": [
    {
      "matches": ["https://*.cps.golf/onlineresweb/search-teetime*"],
      "js": ["cps-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.chronogolf.com/club/*"],
      "js": ["chronogolf-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fox.tenfore.golf/*"],
      "js": ["tenfore-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.ezlinksgolf.com/*"],
      "js": ["ezlinks-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.myvscloud.com/webtrac/web/search.html*"],
      "js": ["webtrac-reader.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://secure.east.prophetservices.com/FrearParkV3/*",
        "https://secure.east.prophetservices.com/SimsburyFarmsV3/*"
      ],
      "js": ["prophet-reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
