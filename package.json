  "overrides": {
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "js-yaml": "4.3.1",
    "postcss": "8.5.25",
    "undici": "7.29.0",
    "next": {
      "sharp": "0.35.3"
    }
  }
