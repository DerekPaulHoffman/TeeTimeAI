{
  "name": "tee-time-spot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "check:cycles": "knip --no-progress --include cycles",
    "check:dead-code": "knip --no-progress --include files,dependencies,unlisted,unresolved",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.ci.json",
    "ui:smoke": "playwright test",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "automation:poll": "tsx scripts/automation/poll-active-searches.ts",
    "automation:browser-probe": "tsx scripts/automation/browser-probe-needed-adapters.ts",
    "automation:preflight": "node scripts/automation/preflight.mjs",
    "automation:improve": "tsx scripts/automation/improvement-loop.ts",
    "automation:inspect": "tsx scripts/automation/inspect-state.ts",
    "automation:inspect-storage": "tsx scripts/automation/inspect-postgres-storage.ts",
    "deployment:wait": "tsx scripts/automation/wait-for-git-deployment.ts",
    "preview:validate-url": "tsx scripts/ci/validate-preview-url.ts",
    "automation:backfill-timezones": "tsx scripts/automation/backfill-course-timezones.ts",
    "automation:place-review": "tsx scripts/automation/manage-google-place-review.ts",
    "automation:course-support": "tsx scripts/automation/course-support.ts",
    "automation:course-support:preflight": "node scripts/automation/course-support-preflight.mjs",
    "automation:course-profile": "tsx scripts/automation/course-profile.ts",
    "automation:course-monitoring": "tsx scripts/automation/course-monitoring.ts",
    "automation:local-reader-verification": "tsx scripts/automation/local-reader-verification.ts",
    "automation:backfill-synthetic-remediation": "tsx scripts/automation/backfill-synthetic-remediation.ts",
    "automation:repair-synthetic-delivery-state": "tsx scripts/automation/repair-synthetic-delivery-state.ts",
    "automation:durable-operations": "tsx scripts/automation/durable-operations.ts",
    "local-reader:proof-backend": "tsx tools/local-chrome-reader/mock-backend.ts",
    "maintenance:scrub-engagement-privacy": "tsx scripts/maintenance/scrub-engagement-privacy.ts",
    "qa:public-browser-reader": "vitest run --config tools/public-tee-time-reader/vitest.config.ts",
    "seed:foreup": "tsx scripts/seed-foreup.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.1",
    "@photostructure/tz-lookup": "^11.6.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.7.6",
    "@vercel/queue": "^0.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.0",
    "workflow": "4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^27.2.0",
    "knip": "^6.29.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
